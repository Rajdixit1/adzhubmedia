SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=
ADMIN_EMAIL=admin@adzhubmedia.com
ADMIN_PASSWORD=admin123

# Leave SMTP_HOST empty to write emails to logs/emails.log instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@adzhubmedia.com
MAX_UPLOAD_MB=10

# WhatsApp: twilio | meta. Leave empty to write messages to logs/whatsapp.log instead of sending
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WA_TOKEN=
META_WA_PHONE_ID=
# Added to 10-digit phone numbers that have no country code
DEFAULT_COUNTRY_CODE=91
